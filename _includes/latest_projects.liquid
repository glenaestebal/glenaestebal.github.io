<div class="projects">
  {% if site.projects != blank %}
    {% assign projects_size = site.projects | size %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% assign latest_projects = site.projects | sort: "importance" | reverse %}
        {% assign latest_projects_limit = site.latest_projects.limit | default: projects_size %}
        {% for item in latest_projects limit: latest_projects_limit %}
          <tr>
            <th scope="row" style="width: 20%">
              {{ item.date | date: "%b %d, %Y" }}
            </th>
            <td>
              <a class="news-title" href="{{ item.url | relative_url }}">
                {{ item.title }}
              </a>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No projects yet…</p>
  {% endif %}
</div>